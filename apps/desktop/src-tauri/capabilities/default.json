{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the MOSS desktop window",
  "windows": ["*"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "allow-get-backend-origin",
    "allow-get-desktop-session",
    "allow-save-export-file",
    "allow-get-export-settings",
    "allow-pick-export-dir",
    "allow-reset-export-dir",
    "allow-set-export-ask-each-time",
    "allow-open-export-dir",
    "allow-reveal-exported-file",
    "allow-minimize-to-tray",
    "allow-exit-application",
    "allow-app-update-status",
    "allow-app-update-install",
    "allow-voice-status",
    "allow-voice-save-settings",
    "allow-voice-mode-changes",
    "allow-voice-set-mode",
    "allow-voice-server-start",
    "allow-voice-server-stop",
    "allow-voice-server-restart",
    "allow-voice-server-log",
    "allow-voice-models-test",
    "allow-voice-models-save",
    "allow-voice-detect-python",
    "allow-voice-strict-set",
    "allow-voice-builtin-status",
    "allow-voice-builtin-start",
    "allow-voice-builtin-stop",
    "allow-voice-diagnostics-export",
    "allow-voice-device-set-status",
    "allow-voice-device-rename",
    "allow-voice-device-request",
    "allow-voice-builtin-models-test",
    "allow-voice-builtin-models-list",
    "allow-voice-builtin-models-save",
    "allow-voice-local-save",
    "allow-voice-local-model-download",
    "allow-voice-local-model-cancel",
    "allow-voice-local-model-delete",
    "allow-voice-local-laya-setup"
  ]
}
