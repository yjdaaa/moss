<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSLocalNetworkUsageDescription</key>
  <string>MOSS 需要访问局域网以发现并连接 FluidNC 激光控制器、小智语音设备与本地智能家居服务。</string>
  <key>NSLocationUsageDescription</key>
  <string>macOS 要求应用有定位权限才能读取 Wi-Fi 名称。MOSS 只在你点“用本机当前 Wi-Fi”或“扫描附近”时读取网络名给 USB 配网填写，不读取、不保存你的位置。</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>macOS 要求应用有定位权限才能读取 Wi-Fi 名称。MOSS 只在你点“用本机当前 Wi-Fi”或“扫描附近”时读取网络名给 USB 配网填写，不读取、不保存你的位置。</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>用于录制本机语音测试语料</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_telnet._tcp</string>
    <string>_http._tcp</string>
  </array>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
</dict>
</plist>
