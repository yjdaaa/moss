{
  "version": 1,
  "name": "MOSS L0 模拟机默认全自动场景集",
  "scenarios": [
    {
      "id": "gen_text",
      "name": "文字任务预览生成",
      "category": "generation",
      "description": "验证 /api/text-task/generate 生成矢量文字 G-code、预览图、SHA-256 与工时估算",
      "params": {
        "text": "MOSS-BENCH",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 10,
        "text_fill": "outline"
      }
    },
    {
      "id": "gen_image",
      "name": "图片任务预览生成",
      "category": "generation",
      "description": "上传合成测试 PNG 并经 /api/workflow preview 生成光栅刀路与预览图",
      "params": {
        "material": "椴木",
        "thickness_mm": 3,
        "width_mm": 20,
        "image_mode": "threshold"
      }
    },
    {
      "id": "gen_draw",
      "name": "创作画板预览生成",
      "category": "generation",
      "description": "经 /api/draw/preview 生成画板矢量刀路、内容指纹与场景存档",
      "params": {
        "material": "椴木",
        "thickness_mm": 3,
        "mode": "vector",
        "vector_style": "outline",
        "width_mm": 30,
        "height_mm": 20
      }
    },
    {
      "id": "gen_material_matrix",
      "name": "材料测试矩阵预览生成",
      "category": "generation",
      "description": "经 /api/material-lab/preview 生成 2×2 功率×速度材料测试矩阵",
      "params": {
        "material": "椴木",
        "thickness_mm": 3,
        "laser_mode": "engrave",
        "engraving_mode": "raster",
        "test_type": "matrix",
        "rows": 2,
        "columns": 2,
        "cell_size_mm": 6,
        "cell_gap_mm": 2,
        "power_min": 150,
        "power_max": 350,
        "speed_min": 1200,
        "speed_max": 2400
      }
    },
    {
      "id": "gen_wizard_patterns",
      "name": "向导测试图案预览生成",
      "category": "generation",
      "description": "覆盖 interval、scan_offset、overscan、kerf 四类材料测试与标定向导图案预览",
      "params": {
        "material": "椴木",
        "thickness_mm": 3,
        "patterns": ["interval", "scan_offset", "overscan", "kerf"]
      }
    },
    {
      "id": "send_text_complete",
      "name": "文字任务确认发送并完整跑完",
      "category": "send",
      "description": "确认后流式发送到模拟器直至 completed，校验 SHA、关光、行程与工时估算偏差",
      "profileOverrides": {
        "initialMpos": [100, 100, 0],
        "ackDelayMs": 1
      },
      "params": {
        "text": "SIM-OK",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 10,
        "text_fill": "outline"
      }
    },
    {
      "id": "send_rescaled_s255",
      "name": "$30=255 固件 S 值等比换算发送",
      "category": "send",
      "description": "模拟器设定 $30=255，验证全部下发 S 值被正确换算且不超过 255",
      "profileOverrides": {
        "maxSpindleSpeed": 255,
        "initialMpos": [100, 100, 0],
        "ackDelayMs": 1
      },
      "params": {
        "text": "S255",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 10,
        "text_fill": "outline"
      }
    },
    {
      "id": "framing_pause_resume_stop",
      "name": "走边框运行中暂停、继续与停止",
      "category": "control",
      "description": "走边框期间测试 pause(!) / resume(~, confirmed=true) 与 stop_framing(! → ? → 0x18)",
      "profileOverrides": {
        "initialMpos": [50, 50, 0],
        "ackDelayMs": 60
      },
      "params": {
        "min_x": 0,
        "max_x": 20,
        "min_y": 0,
        "max_y": 15,
        "feed_rate": 2000,
        "power": 0
      }
    },
    {
      "id": "send_cancel",
      "name": "加工中途取消（! → ? → 0x18）",
      "category": "control",
      "description": "流式发送中途发起 workflow cancel，验证 ! → ? → 0x18 顺序与复位后零刀路下发",
      "profileOverrides": {
        "initialMpos": [100, 100, 0],
        "ackDelayMs": 12
      },
      "params": {
        "text": "CANCEL-ME",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 10,
        "text_fill": "outline"
      }
    },
    {
      "id": "send_estop_realtime",
      "name": "背压排队下急停 0x18 实时直达",
      "category": "control",
      "description": "模拟慢 ACK / 阻塞背压时触发 emergency_stop，校验 0x18 走实时通道不排在 G-code 队列后面",
      "profileOverrides": {
        "initialMpos": [100, 100, 0],
        "ackDelayMs": 80,
        "faults": {
          "freezeAfterLines": 8
        }
      },
      "params": {
        "text": "ESTOP-NOW",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 10,
        "text_fill": "outline",
        "maxEstopLatencyMs": 500
      }
    },
    {
      "id": "send_resume_ln",
      "name": "FluidNC 行号证实断点续雕",
      "category": "control",
      "description": "启用 use_line_numbers:true，Hold:0|Ln:K 证实断点后续雕，核对起始行 = resumable_from_line + 1 且不重复出光",
      "profileOverrides": {
        "firmware": "fluidnc",
        "useLineNumbers": true,
        "initialMpos": [100, 100, 0],
        "ackDelayMs": 10,
        "plannerLagLines": 4
      },
      "params": {
        "text": "RESUME-LN",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 10,
        "text_fill": "outline"
      }
    },
    {
      "id": "override_active_and_idle",
      "name": "实时倍率：空闲必拒、运行中命中原通道",
      "category": "override",
      "description": "无活动任务时倍率必须返回 no_active_job（0 字节）；运行中任务期间 0x90–0x9B 必须经原任务通道到达",
      "profileOverrides": {
        "initialMpos": [100, 100, 0],
        "ackDelayMs": 3
      },
      "params": {
        "text": "OVR-TEST",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 10,
        "text_fill": "outline"
      }
    },
    {
      "id": "move_framing",
      "name": "走边框移动与关光检查",
      "category": "motion",
      "description": "执行无光走边框 /api/device/framing，核对移动前先关光且全程无出光",
      "profileOverrides": {
        "initialMpos": [50, 50, 0],
        "ackDelayMs": 2
      },
      "params": {
        "min_x": 0,
        "max_x": 25,
        "min_y": 0,
        "max_y": 20,
        "feed_rate": 2000,
        "power": 0
      }
    },
    {
      "id": "move_jog_relative",
      "name": "点动相对移动（关光 + G91 → G90 恢复）",
      "category": "motion",
      "description": "执行 relative_move 点动，核对移动前 M5 关光、使用 G91 且结束后恢复 G90",
      "profileOverrides": {
        "initialMpos": [50, 50, 0],
        "ackDelayMs": 2
      },
      "params": {
        "x": 5,
        "y": 3,
        "feed_rate": 1200
      }
    },
    {
      "id": "move_return_origin",
      "name": "回工作原点（G1 且 S0 控速关光移动）",
      "category": "motion",
      "description": "执行 absolute_move(0,0)，核对下发 M5、G90 且使用带 S0 的 G1（非 G0）",
      "profileOverrides": {
        "initialMpos": [40, 30, 0],
        "ackDelayMs": 2
      },
      "params": {
        "x": 0,
        "y": 0,
        "feed_rate": 1000
      }
    },
    {
      "id": "move_home_enabled_and_disabled",
      "name": "机械回零（$22=1 正常，$22=0 必须禁用）",
      "category": "motion",
      "description": "分别在 $22=1 与 $22=0 固件配置下测试连接探测与 home，核对 $22=0 时不会发送 $H",
      "profileOverrides": {
        "ackDelayMs": 2
      },
      "params": {}
    },
    {
      "id": "fault_mid_alarm",
      "name": "故障注入：加工中途报警 ALARM:1",
      "category": "fault",
      "description": "下发第 5 行时注入 ALARM:1，核对任务记 failed、can_resume=false、不自动重发并补发 0x18",
      "profileOverrides": {
        "initialMpos": [100, 100, 0],
        "ackDelayMs": 5,
        "faults": {
          "alarmAfterLines": 5,
          "alarmCode": 1
        }
      },
      "params": {
        "text": "ALARM1",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 10,
        "text_fill": "outline"
      }
    },
    {
      "id": "fault_mid_disconnect",
      "name": "故障注入：加工中途断连",
      "category": "fault",
      "description": "下发第 5 行时模拟 TCP 突然断开，核对任务记 failed/result_unknown 且不自动重发",
      "profileOverrides": {
        "initialMpos": [100, 100, 0],
        "ackDelayMs": 5,
        "faults": {
          "disconnectAfterLines": 5
        }
      },
      "params": {
        "text": "DISCONN",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 10,
        "text_fill": "outline"
      }
    },
    {
      "id": "fault_mid_door_open",
      "name": "故障注入：加工中途安全门打开 Pn:D",
      "category": "fault",
      "description": "下发第 5 行时注入 Door:1 与 Pn:D，核对阻断引脚立即中止加工并补发 0x18",
      "profileOverrides": {
        "initialMpos": [100, 100, 0],
        "ackDelayMs": 5,
        "faults": {
          "doorOpenAfterLines": 5
        }
      },
      "params": {
        "text": "DOOR-D",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 10,
        "text_fill": "outline"
      }
    },
    {
      "id": "fault_soft_limit",
      "name": "故障注入：软限位报警 ALARM:2",
      "category": "fault",
      "description": "下发第 4 行时注入 ALARM:2 软限位报警，核对任务安全中止为 failed 且不可盲目续雕",
      "profileOverrides": {
        "initialMpos": [100, 100, 0],
        "ackDelayMs": 5,
        "faults": {
          "softLimitAfterLines": 4
        }
      },
      "params": {
        "text": "SOFTLIM",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 10,
        "text_fill": "outline"
      }
    },
    {
      "id": "fault_slow_ack_and_no_travel",
      "name": "慢 ACK + 不报行程警告 + 超速/边缘警告一致性",
      "category": "fault",
      "description": "验证慢 ACK 稳定跑完、不报行程且软限位关返回警告、超速预览警告与机械坐标边缘越界警告一致性",
      "profileOverrides": {
        "omitTravel": true,
        "softLimits": false,
        "ackDelayMs": 25,
        "initialMpos": [50, 50, 0]
      },
      "params": {
        "text": "WARN",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 8,
        "text_fill": "outline"
      }
    },
    {
      "id": "gate_unconfirmed_send",
      "name": "门禁：未确认（confirmed=false）拒绝发送",
      "category": "gate",
      "description": "验证 /api/workflow confirm_send 与 /api/text-task/send 在 confirmed=false 时返回 400 且零字节发往设备",
      "profileOverrides": {
        "ackDelayMs": 1
      },
      "params": {
        "text": "NOCONF",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 8,
        "text_fill": "outline"
      }
    },
    {
      "id": "gate_tampered_gcode_sha",
      "name": "门禁：发送前物理 G-code 被篡改（SHA 不一致）拒绝发送",
      "category": "gate",
      "description": "预览后改写隔离运行目录里的物理 .gcode 文件，验证发送返回 400 send_gate_rejected 且零字节发往设备",
      "profileOverrides": {
        "ackDelayMs": 1
      },
      "params": {
        "text": "SHA-CHK",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 8,
        "text_fill": "outline"
      }
    },
    {
      "id": "gate_exceeds_travel",
      "name": "门禁：刀路超出固件行程拒绝发送",
      "category": "gate",
      "description": "生成宽于 60 mm 固件行程的刀路并向 60×60 模拟器发送，验证返回 400 job_exceeds_travel 且不下发运动行",
      "profileOverrides": {
        "travelX": 60,
        "travelY": 60,
        "initialMpos": [30, 30, 0],
        "ackDelayMs": 1
      },
      "params": {
        "text": "TOO-WIDE-TEXT",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 12,
        "work_area_width_mm": 200,
        "work_area_height_mm": 200,
        "text_fill": "outline"
      }
    },
    {
      "id": "gate_lan_readonly_and_auth",
      "name": "门禁：局域网只读 / 未鉴权 / 严格模式与跨源发送拒绝",
      "category": "gate",
      "description": "验证跨源 Origin、DNS 重绑定 Host、无效桌面会话、未鉴权局域网与严格模式下局域网身份均不得直接发送激光任务",
      "profileOverrides": {
        "ackDelayMs": 1
      },
      "params": {
        "text": "LAN-GATE",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 8,
        "text_fill": "outline"
      }
    },
    {
      "id": "dryrun_mode_enforced",
      "name": "空跑模式：后端强制 S0、G0 限速、F 钳位与 ProcessTrace 来源标记",
      "category": "gate",
      "description": "在隔离 moss-host 上开启空跑模式（限速 1600 mm/min），验证文字任务、走边框、点动、点射全部强制 S0 与限速，且关闭后恢复正常",
      "profileOverrides": {
        "initialMpos": [100, 100, 0],
        "ackDelayMs": 1
      },
      "params": {
        "max_feed_mm_min": 1600,
        "text": "DRY-OK",
        "material": "椴木",
        "thickness_mm": 3,
        "font_size_mm": 8,
        "text_fill": "outline"
      }
    }
  ]
}
